# Copie para .env.local e preencha. NUNCA commite .env.local.
# O painel `curso-on` preenche este arquivo por você.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública do app (redirects de e-mail e OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: pré-correção de redação por IA (só no servidor). Sem chave, o botão
# some. Com as duas, usa a Anthropic. O professor sempre decide a nota final.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
