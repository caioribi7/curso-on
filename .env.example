# Copie para .env.local e preencha. NUNCA commite .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (service role). Só no servidor; usada pelo webhook do Stripe.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe → Developers → API keys (use as chaves de teste em dev)
STRIPE_SECRET_KEY=sk_test_xxx
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` mostra este segredo
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL pública do app (redirects de e-mail, OAuth e Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
