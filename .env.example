# Copie para .env.local e preencha. NUNCA commite .env.local.
# O painel `curso-on` preenche este arquivo por você (menu Integrações),
# e pode guardar os segredos no chaveiro do sistema em vez daqui.
# Passo a passo de cada chave: docs/integracoes.md

# Supabase (obrigatório) → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública do app (redirects de e-mail e OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Opcionais: deixe vazio o que não usar ----------

# Masterbase (vazio = Supabase local)
MASTERBASE_DATABASE_URL=

# Stripe: só se você quiser cobrar. Sem as duas, tudo continua grátis.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (e-mail)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare R2 ou AWS S3 (arquivos e vídeos). Região: auto no R2, sa-east-1 na AWS
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Analytics: um dos dois
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# IA para a pré-correção de redações (em breve): uma das duas
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
